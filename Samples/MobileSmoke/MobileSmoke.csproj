<Project Sdk="Microsoft.NET.Sdk">

  <!-- 移动端兼容冒烟：在主库之上运行核心 API，Android 跑模拟器、iOS 跑模拟器 -->
  <PropertyGroup>
    <!-- CI 只跑单平台时用 -p:MobileTargetFramework=<tfm> 收窄目标框架，避免另一平台的 workload 缺失导致还原期 NETSDK1178。
         这里不能用全局 -p:TargetFrameworks，全局属性会传导到引用的项目，破坏它们自己的目标框架 -->
    <TargetFrameworks Condition="'$(MobileTargetFramework)' != ''">$(MobileTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition="'$(MobileTargetFramework)' == ''">net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MobileSmoke</AssemblyName>
    <RootNamespace>MobileSmoke</RootNamespace>
    <ApplicationId>com.newlife.smoke.remoting</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <OutputPath>..\..\Bin\MobileSmoke</OutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- 冒烟不评估裁剪体积，关闭链路裁剪以保证反射与 GetExportedTypes 可用 -->
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NewLife.Remoting/NewLife.Remoting.csproj" />
  </ItemGroup>

</Project>

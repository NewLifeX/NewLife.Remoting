<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>XCode 设备服务 NativeAOT 冒烟工程</AssemblyTitle>
    <Description>NewLife.Remoting.Extensions 的 DefaultDeviceService + NewLife.XCode 实体在 NativeAOT 下的运行期实测</Description>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- PublishAot 写在工程文件内，勿用命令行 -p: 传入 -->
    <PublishAot>true</PublishAot>
    <!-- CS8632：生成的 XCode 实体未开启可空上下文，本工程随之关闭并保留可空注解 -->
    <!-- CS0414：生成的实体保留 MaxCacheCount 字段但未使用 -->
    <NoWarn>1701;1702;CS7035;CS8632;CS0414;SYSLIB1224</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.XCode" Version="12.2.2026.1017-beta1246" />
    <!-- SQLite 驱动的 AOT 路线：Microsoft.Data.Sqlite（SQLitePCLRaw 原生库）；System.Data.SQLite 为混合编译，不支持 NativeAOT -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- 静态引用驱动裁剪根：配合 XCode 驱动加载器的“程序集限定名”降级路径，在 AOT 下无需动态加载即可命中驱动 -->
    <TrimmerRootAssembly Include="Microsoft.Data.Sqlite" />
    <!-- 程序集名注意：bundle_e_sqlite3 包内的程序集名为 SQLitePCLRaw.batteries_v2 -->
    <TrimmerRootAssembly Include="SQLitePCLRaw.batteries_v2" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.provider.e_sqlite3" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewLife.Remoting.Extensions\NewLife.Remoting.Extensions.csproj" />
  </ItemGroup>

</Project>

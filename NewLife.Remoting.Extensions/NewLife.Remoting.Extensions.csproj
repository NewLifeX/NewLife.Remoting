<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- 目标框架对齐 NewLife.Core v12：net7.0/net9.0 已由上游合并（net7.0→net6.0，net9.0→net8.0），
         保留会被 NuGet 回退到 netstandard2.1 资产，与 Core 内嵌的 CodeAnalysis 补齐类型冲突（CS0433） -->
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <AssemblyTitle>NewLife Remoting Extensions</AssemblyTitle>
    <Description>Device access controllers, token services and session management extensions for NewLife.Remoting.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>4.0</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</AssemblyVersion>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--<WarningsAsErrors>CA2007</WarningsAsErrors>-->
  </PropertyGroup>

  <!-- net8.0+ 常驻启用 AOT 兼容性分析（对齐 NewLife.Core v12 与核心库），net7.0 及以下不适用 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/core/api_server</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Remoting</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;RPC;HTTP;IoT;NativeAOT;AOT;$(AssemblyName)</PackageTags>
    <PackageDescription>Device access controllers, token services and session management extensions for NewLife.Remoting. 提供设备接入控制器、令牌服务与会话管理扩展。</PackageDescription>
    <PackageReleaseNotes>v4 大版本：对齐 NewLife.Core v12 网络层，主端口仅跑 SRMP、HTTP 需显式 HttpPort，移除 ws:// 承载 SRMP 与自研 HTTP/WS 帧栈；支持 NativeAOT 并内置源生成器；新增令牌吊销与访问/刷新令牌分离，GetUserHost 支持可信代理防伪造；新增最小 API 端点宿主，与 MVC 控制器镜像实现同一协议；运行时词表扩展至 31 种语言；升级 NewLife.Core 12.0.2026.1024</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\ITokenSetting.cs" />
    <Compile Remove="Services\IDeviceService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.XCode" Version="12.2.2026.1021-beta0423" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NewLife.Remoting\NewLife.Remoting.csproj" />
  </ItemGroup>

</Project>
